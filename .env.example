# Local secrets. COPY THIS FILE TO `.env` AND FILL IT IN.
#
# `.env` is git-ignored; this example is not. Never commit a real key.
#
# After editing `.env`, restart `npm run dev` (it syncs to `.dev.vars`, which is
# what the local Worker actually reads).

# --- Optional: enable the model qualifier -------------------------------------
# Without a key the engine is rules-only. That is a working mode, not an error:
# every score is tagged `rules` and the UI says so.
#
# Get a Freebuff API key at https://freebuff.com/account/api (Account -> Developer API).
# Every call spends the key owner's credits; the key is only used for rows whose
# rule score already cleared MODEL_GATE (35), so a scan cannot spend per row.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini

# --- Free providers: paste a value after the `=` and restart `npm run dev` -----
# Any one of these is enough, and none needs a card. The engine tries them in the
# order listed in src/worker/model.ts and falls through to a keyless tier.
# GitHub Models: a personal access token with no scopes, from
# https://github.com/settings/tokens
GITHUB_TOKEN=
# GITHUB_MODEL=openai/gpt-4o-mini
# Google AI Studio (Gemini free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Required only for the external discovery runner ---------------------------
# The GitHub Actions cron (or any other runner) POSTs to /api/ingest with
# `Authorization: Bearer <this value>`. Ingest returns 503 when this is unset,
# so the endpoint fails closed rather than accepting anonymous writes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# --- Not needed locally --------------------------------------------------------
# APP_ORIGIN, FREEBUFF_CLIENT_ID and FREEBUFF_ISSUER are injected by Freebuff
# Sites on deploy. Do not set them here.

# Model providers. The engine tries them in this order and uses the first that is
# configured. Any single one is enough. All are free tiers with documented terms.
# LLM_PROVIDER forces one by id: freebuff | groq | openrouter | gemini | github | cerebras | llm7 | pollinations
# LLM_PROVIDER=groq

# Free key, no card. 30 req/min, 1000 req/day. https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Free `:free` models, 20 req/min, 50 req/day. https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Gemini free tier from Google AI Studio. https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# GitHub Models uses a fine-grained personal access token (no scopes needed).
# GITHUB_TOKEN=
# GITHUB_MODEL=openai/gpt-4o-mini

# Cerebras free tier: 1M tokens/day per model. https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Keyless fallback. A real free token from https://dash.llm7.io lifts the limits.
# LLM7_TOKEN=unused
# LLM7_MODEL=DeepSeek-V4-Flash-0731

# Keyless: the anonymous tier answers without any account. A key raises the budget.
# POLLINATIONS_API_KEY=
# POLLINATIONS_MODEL=openai-fast
